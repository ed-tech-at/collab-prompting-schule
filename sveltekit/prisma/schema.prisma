generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Teacher {
  id       String  @id @default(uuid())
  email    String  @unique

  password String
  cryptVersion Int @default(0)

  isDeleted Int @default(0)
  createdAt       DateTime? @default(now())

}


model CollabSpace {
  id            Int      @id @default(autoincrement())
  base_url      String?
  api_key      String?
  model      String?

  password String
  student_pw String?
  cryptVersion Int @default(0)


  question      String?
  system_prompt       String?
    
  createdAt     DateTime @default(now())

  collabChats    CollabChat[]

}

model CollabChat {
  id            Int      @id @default(autoincrement())
  

  collabSpaceId Int
  collabSpace    CollabSpace  @relation(fields: [collabSpaceId], references: [id], onDelete: Cascade)

  username String?

  teacher_rating String?
  student_rating String?

  teacher_comment String?
  student_comment String?

  hidden Boolean @default(false)

  ChatEntries    ChatEntry[]
    
  createdAt     DateTime @default(now())

}


model ChatEntry {
  id            Int      @id @default(autoincrement())


  role String?
  message String?


  collabChatId Int
  collabChat    CollabChat  @relation(fields: [collabChatId], references: [id], onDelete: Cascade)

  
  createdAt     DateTime @default(now())
}



